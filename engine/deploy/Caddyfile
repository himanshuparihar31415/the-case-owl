# HTTPS in front of the engine; Caddy gets and renews the Let's Encrypt certificate itself.
# No access log: the page's UI-socket URL carries its token.
{$DOMAIN} {
	reverse_proxy engine:8080 {
		# A deploy restarts the engine for a few seconds. Hold Node's requests and the page's
		# reconnects until it answers again, rather than returning 502.
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}
