{
  "$schema": "https://openship.io/openship.schema.json",
  "framework": "docker",
  "runtime": "docker",
  "workload": "web",
  "rootDirectory": "engine",
  "port": 8080,
  "readiness": {
    "enabled": true,
    "path": "/readyz",
    "timeoutSeconds": 90,
    "stabilization": true,
    "stabilizationSeconds": 10,
    "onFailure": "fail"
  },
  "autoDeployPaths": {
    "include": ["engine/app/**", "engine/cases/**", "engine/pyproject.toml", "engine/uv.lock",
                "engine/Dockerfile", "engine/Dockerfile.dockerignore", "engine/openship.json"]
  }
}
